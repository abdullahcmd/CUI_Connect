PORT=4000
MONGO_URL=mongodb://127.0.0.1:27017/cui_connect
JWT_SECRET=dev-only-secret-change-me-please-0123456789
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# REDIS_URL=redis://127.0.0.1:6379   (optional: enables the Socket.IO redis adapter)

# Generate with: npm run keygen
MESSAGE_KEY=
